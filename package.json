{
  "name": "personal-site",
  "version": "5.0.0",
  "type": "module",
  "private": true,
  "homepage": "https://grapentt.github.io/personal-website",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grapentt/personal-website.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run smoke",
    "smoke": "esbuild scripts/smoke-test.ts --bundle --platform=node --format=esm --alias:@=./src --log-level=warning --outfile=node_modules/.cache/smoke-test.mjs && node node_modules/.cache/smoke-test.mjs",
    "cv": "node scripts/build-cv.mjs",
    "stats": "esbuild scripts/fetch-stats.ts --bundle --platform=node --format=esm --external:*.mdx --log-level=warning --outfile=scripts/.fetch-stats.mjs && node scripts/.fetch-stats.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/spectral": "^5.2.5",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "esbuild": "^0.27.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
